{
  "name": "kata-minesweeper-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open /vite.html",
    "build": "tsc && vite build",
    "build:file": "npm run build && node scripts/build-file.mjs",
    "check": "npm run test:unit && npm run build",
    "test:file": "npm run build:file && PLAYWRIGHT_NO_WEBSERVER=1 playwright test tests/direct-file.spec.ts",
    "test:unit": "vitest run src",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
